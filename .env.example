# Copy to .env and fill in. No real values here.
APP_ENV=development
CORS_ORIGINS=["http://localhost:7860"]
RATE_LIMIT_PER_MINUTE=20
MAX_TOKENS_PER_RESPONSE=500
HISTORY_MAX_MESSAGES=10
ADMIN_API_KEY=
MAX_MESSAGE_CHARS=1000
TRUST_PROXY_HEADERS=false

# Knowledge base / RAG
DATA_DIR=data
STORAGE_DIR=storage
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=models
VECTOR_STORE=chroma
AUTO_INGEST=true
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.30

# LLM: gemini (default, free tier from Google AI Studio), anthropic or openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional providers (also need `pip install langchain-anthropic` / `langchain-openai`)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
